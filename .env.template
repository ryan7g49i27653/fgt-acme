IMAGE_TAG=latest

# The subdomain that will actually receive the cert. Must be a real,
# publicly resolvable domain/subdomain delegated to Cloudflare — NOT
# home.local. E.g. fw.yourdomain.com
ACME_DOMAIN=

# Contact address for Let's Encrypt expiry notices
ACME_EMAIL=

# Extra certbot flags if ever needed (staging testing, etc). Leave blank normally.
CERTBOT_EXTRA_ARGS=

# LAN IP or hostname of the FortiGate, and its admin HTTPS port
FGT_HOST=
FGT_PORT=443

# The actual vdom name — "root" for a standard single-vdom FortiGate,
# even with multi-vdom mode disabled. NOT the literal string "global".
FGT_VDOM=root

# SHA256 fingerprint (colon-hex) of the FortiGate's CURRENT admin cert,
# used to pin the API connection instead of disabling TLS verification.
# Get it with:
#   openssl s_client -connect $FGT_HOST:$FGT_PORT </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
FGT_CERT_FP=
